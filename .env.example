# Root-level env — read by `docker compose` for variable interpolation AND
# passed into the django / celery containers. Copy to `.env` (gitignored).
#
# Generate the Redis password with:
#   python3 -c "from secrets import token_urlsafe; print(token_urlsafe(32))"
#
# Use a URL-safe password (letters, digits, - and _). It is interpolated into
# PORTEX_REDIS_URL verbatim, so characters like @ : / would split the URL.

# Redis requires this password. Postgres and Redis are NOT published to the
# host — they are reachable only from inside the compose network.
REDIS_PASSWORD=replace-me-with-a-long-random-string

# Apex domain the gateway strips off the Host header. For local testing use
# localtest.me — a public zone where *.localtest.me always resolves to
# 127.0.0.1, which is what test_e2e.sh expects.
PORTEX_BASE_DOMAIN=portex.live
